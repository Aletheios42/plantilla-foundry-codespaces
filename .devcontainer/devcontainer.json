{
  "name": "EntreTodos",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "cd frontend && npm run dev -- --host",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "SEPOLIA_RPC_URL": { "description": "Alchemy Sepolia RPC URL" },
    "PRIVATE_KEY": { "description": "Burner wallet key (Sepolia only)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["NomicFoundation.hardhat-solidity", "esbenp.prettier-vscode"]
    }
  }
}
